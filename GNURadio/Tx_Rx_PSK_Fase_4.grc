- name: e_BER_Curve
  id: epy_block
  parameters:
    EbN0_max: EbN0_max
    EbN0_min: EbN0_min
    EbN0_step: EbN0_step
    _source_code: "\"\"\"\ne_BER_Curve\nAcumulador de curva BER para los sistemas\
      \ de los estudiantes.\n\nEntrada 0 : bits transmitidos de referencia (byte 0/1).\n\
      Entrada 1 : bits recuperados por el receptor (byte 0/1).\n\nSalida 0  : vector\
      \ BER lineal.\nSalida 1  : vector log10(BER) para QT GUI Vector Sink.\n\nEl\
      \ bloque usa exactamente el mismo barrido que e_EbN0_Sweep. Para cada punto:\n\
      - ignora bits_guardia al comienzo del segmento;\n- compara bits_por_punto;\n\
      - cuando el barrido vuelve a un punto, sigue acumulando estad\xEDsticas.\n\n\
      delay_bits retrasa internamente la referencia Tx para compensar el retardo\n\
      del receptor. Se ajusta primero en una condici\xF3n limpia hasta lograr BER\u2248\
      0.\n\nCuando todav\xEDa no se observa ning\xFAn error, la salida logar\xEDtmica\
      \ utiliza\n3/N como cota superior aproximada para poder mostrar el punto sin\
      \ afirmar\nque BER=0.\n\"\"\"\n\nimport numpy as np\nfrom collections import\
      \ deque\nfrom gnuradio import gr\n\n\nclass blk(gr.decim_block):\n    def __init__(self,\n\
      \                 EbN0_min=0.0,\n                 EbN0_max=14.0,\n         \
      \        EbN0_step=1.0,\n                 bits_por_punto=100000,\n         \
      \        bits_guardia=1000,\n                 delay_bits=0,\n              \
      \   update_every=1000):\n        self.EbN0_min = float(EbN0_min)\n        self.EbN0_max\
      \ = float(EbN0_max)\n        self.EbN0_step = float(EbN0_step)\n        self.bits_por_punto\
      \ = max(1, int(bits_por_punto))\n        self.bits_guardia = max(0, int(bits_guardia))\n\
      \        self.delay_bits = max(0, int(delay_bits))\n        self.update_every\
      \ = max(1, int(update_every))\n\n        if self.EbN0_step <= 0:\n         \
      \   raise ValueError(\"EbN0_step debe ser > 0\")\n        if self.EbN0_max <\
      \ self.EbN0_min:\n            raise ValueError(\"EbN0_max debe ser >= EbN0_min\"\
      )\n\n        npts = int(round((self.EbN0_max-self.EbN0_min)/self.EbN0_step))\
      \ + 1\n        self.eb_axis = self.EbN0_min + self.EbN0_step*np.arange(npts,\
      \ dtype=np.float64)\n        self.N = len(self.eb_axis)\n        self.segment_bits\
      \ = self.bits_guardia + self.bits_por_punto\n\n        gr.decim_block.__init__(\n\
      \            self,\n            name='e_BER_Curve',\n            in_sig=[np.uint8,\
      \ np.uint8],\n            out_sig=[(np.float32, self.N), (np.float32, self.N)],\n\
      \            decim=self.update_every\n        )\n\n        self.tx_fifo = deque([0]*self.delay_bits)\n\
      \        self.raw_items = 0\n        self.valid_bit_index = 0\n\n        self.count\
      \ = np.zeros(self.N, dtype=np.int64)\n        self.errors = np.zeros(self.N,\
      \ dtype=np.int64)\n\n    def _process(self, tx, rx):\n        for t, r in zip(tx,\
      \ rx):\n            tb = int(t) & 1\n            rb = int(r) & 1\n\n       \
      \     if self.delay_bits > 0:\n                self.tx_fifo.append(tb)\n   \
      \             t_aligned = self.tx_fifo.popleft()\n                if self.raw_items\
      \ < self.delay_bits:\n                    self.raw_items += 1\n            \
      \        continue\n            else:\n                t_aligned = tb\n\n   \
      \         bit_index = self.valid_bit_index\n            segment_index = bit_index\
      \ // self.segment_bits\n            point_index = segment_index % self.N\n \
      \           pos = bit_index % self.segment_bits\n\n            # Dejar que filtros/sincronizadores\
      \ se estabilicen despu\xE9s\n            # del cambio de nivel de ruido.\n \
      \           if pos >= self.bits_guardia:\n                self.count[point_index]\
      \ += 1\n                if t_aligned != rb:\n                    self.errors[point_index]\
      \ += 1\n\n            self.valid_bit_index += 1\n            self.raw_items\
      \ += 1\n\n    def _vectors(self):\n        ber = np.zeros(self.N, dtype=np.float32)\n\
      \        logber = np.zeros(self.N, dtype=np.float32)\n\n        for i in range(self.N):\n\
      \            n = int(self.count[i])\n            e = int(self.errors[i])\n\n\
      \            if n <= 0:\n                ber[i] = 0.0\n                logber[i]\
      \ = 0.0\n            elif e > 0:\n                b = e/float(n)\n         \
      \       ber[i] = b\n                logber[i] = np.log10(max(b, 1e-12))\n  \
      \          else:\n                # BER observado = 0; para la gr\xE1fica usamos\
      \ una cota superior.\n                ber[i] = 0.0\n                upper =\
      \ min(1.0, 3.0/float(n))\n                logber[i] = np.log10(max(upper, 1e-12))\n\
      \n        return ber, logber\n\n    def work(self, input_items, output_items):\n\
      \        tx = input_items[0]\n        rx = input_items[1]\n        out_ber =\
      \ output_items[0]\n        out_log = output_items[1]\n\n        nout = len(out_ber)\n\
      \        D = self.update_every\n\n        for k in range(nout):\n          \
      \  a = k*D\n            b = min((k+1)*D, len(tx))\n            if a < b:\n \
      \               self._process(tx[a:b], rx[a:b])\n\n            ber, logber =\
      \ self._vectors()\n            out_ber[k, :] = ber\n            out_log[k, :]\
      \ = logber\n\n        return nout\n"
    affinity: ''
    alias: ''
    bits_guardia: bits_guardia
    bits_por_punto: bits_por_punto
    comment: ''
    delay_bits: delay_bits
    maxoutbuf: '0'
    minoutbuf: '0'
    update_every: update_every
  states:
    _io_cache: ('e_BER_Curve', 'blk', [('EbN0_min', '0.0'), ('EbN0_max', '14.0'),
      ('EbN0_step', '1.0'), ('bits_por_punto', '100000'), ('bits_guardia', '1000'),
      ('delay_bits', '0'), ('update_every', '1000')], [('0', 'byte', 1), ('1', 'byte',
      1)], [('0', 'float', 15), ('1', 'float', 15)], '', ['EbN0_max', 'EbN0_min',
      'EbN0_step', 'bits_guardia', 'bits_por_punto', 'delay_bits', 'update_every'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1480, 836.0]
    rotation: 0
    state: enabled
- name: e_EbN0_Sweep
  id: epy_block
  parameters:
    EbN0_max: EbN0_max
    EbN0_min: EbN0_min
    EbN0_step: EbN0_step
    _source_code: "\"\"\"\ne_EbN0_Sweep\nInstrumento para caracterizaci\xF3n BER con\
      \ un enlace SDR ya funcional.\n\nEntrada 0 : se\xF1al compleja I/Q recibida\
      \ del SDR (preferiblemente DESPU\xC9S\n            de la adaptaci\xF3n radio_rate\
      \ -> bb_rate).\nSalida 0  : la misma se\xF1al I/Q con AWGN adicional controlado.\n\
      Salida 1  : valor instant\xE1neo de Eb/N0 [dB] usado en el barrido.\n\nEl bloque\
      \ NO sustituye el USRP/HackRF ni el receptor. Se inserta entre\nla salida I/Q\
      \ del SDR y la entrada del receptor digital.\n\nEl barrido se hace por segmentos\
      \ contiguos. Cada punto se mantiene durante:\n    bits_guardia + bits_por_punto\n\
      \nLa potencia de ruido artificial se calcula a partir de la potencia promedio\n\
      medida ANTES de agregar el ruido:\n\n    Eb = Ps / Rb\n    N0 = Eb / (Eb/N0)\n\
      \    Pn = N0 * Fs\n\npor lo tanto:\n\n    Pn = Ps * Fs / (Rb * 10**(EbN0_dB/10))\n\
      \nEl ruido complejo se genera con varianza total Pn.\n\"\"\"\n\nimport numpy\
      \ as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n    def __init__(self,\n\
      \                 EbN0_min=0.0,\n                 EbN0_max=14.0,\n         \
      \        EbN0_step=1.0,\n                 samp_rate=256000.0,\n            \
      \     bit_rate=64000.0,\n                 bits_por_punto=100000,\n         \
      \        bits_guardia=1000,\n                 signal_power=0.0,\n          \
      \       seed=2026):\n        gr.sync_block.__init__(\n            self,\n  \
      \          name='e_EbN0_Sweep',\n            in_sig=[np.complex64],\n      \
      \      out_sig=[np.complex64, np.float32]\n        )\n\n        self.EbN0_min\
      \ = float(EbN0_min)\n        self.EbN0_max = float(EbN0_max)\n        self.EbN0_step\
      \ = float(EbN0_step)\n        self.samp_rate = float(samp_rate)\n        self.bit_rate\
      \ = float(bit_rate)\n        self.bits_por_punto = max(1, int(bits_por_punto))\n\
      \        self.bits_guardia = max(0, int(bits_guardia))\n        self.signal_power_cfg\
      \ = float(signal_power)\n\n        if self.EbN0_step <= 0:\n            raise\
      \ ValueError(\"EbN0_step debe ser > 0\")\n        if self.samp_rate <= 0 or\
      \ self.bit_rate <= 0:\n            raise ValueError(\"samp_rate y bit_rate deben\
      \ ser > 0\")\n        if self.EbN0_max < self.EbN0_min:\n            raise ValueError(\"\
      EbN0_max debe ser >= EbN0_min\")\n\n        npts = int(round((self.EbN0_max-self.EbN0_min)/self.EbN0_step))\
      \ + 1\n        self.eb_axis = self.EbN0_min + self.EbN0_step*np.arange(npts,\
      \ dtype=np.float64)\n        self.segment_bits = self.bits_guardia + self.bits_por_punto\n\
      \n        self.sample_count = 0\n        self.power_sum = 0.0\n        self.power_count\
      \ = 0\n        self.rng = np.random.default_rng(int(seed))\n\n    def _signal_power(self,\
      \ x):\n        if self.signal_power_cfg > 0:\n            return self.signal_power_cfg\n\
      \n        # Promedio acumulado de la se\xF1al recibida ANTES del ruido artificial.\n\
      \        self.power_sum += float(np.sum(np.abs(x.astype(np.complex128))**2))\n\
      \        self.power_count += len(x)\n        if self.power_count <= 0:\n   \
      \         return 0.0\n        return max(self.power_sum/self.power_count, 1e-20)\n\
      \n    def work(self, input_items, output_items):\n        x = input_items[0]\n\
      \        y = output_items[0]\n        eb_out = output_items[1]\n        n =\
      \ len(x)\n        if n == 0:\n            return 0\n\n        Ps = self._signal_power(x)\n\
      \n        # \xCDndice absoluto de muestra -> \xEDndice equivalente de bit.\n\
      \        s = self.sample_count + np.arange(n, dtype=np.float64)\n        bit_index\
      \ = np.floor(s*self.bit_rate/self.samp_rate).astype(np.int64)\n\n        segment_index\
      \ = bit_index // self.segment_bits\n        point_index = np.mod(segment_index,\
      \ len(self.eb_axis))\n        ebn0_db = self.eb_axis[point_index]\n        ebn0_lin\
      \ = np.power(10.0, ebn0_db/10.0)\n\n        # Potencia total del ruido complejo\
      \ por muestra.\n        noise_power = Ps*self.samp_rate/(self.bit_rate*ebn0_lin)\n\
      \        sigma_iq = np.sqrt(np.maximum(noise_power, 0.0)/2.0)\n\n        noise\
      \ = (\n            self.rng.standard_normal(n)*sigma_iq\n            + 1j*self.rng.standard_normal(n)*sigma_iq\n\
      \        ).astype(np.complex64)\n\n        y[:] = x + noise\n        eb_out[:]\
      \ = ebn0_db.astype(np.float32)\n\n        self.sample_count += n\n        return\
      \ n\n"
    affinity: ''
    alias: ''
    bit_rate: Rb
    bits_guardia: bits_guardia
    bits_por_punto: bits_por_punto
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: bb_rate
    seed: '2026'
    signal_power: '0.0'
  states:
    _io_cache: ('e_EbN0_Sweep', 'blk', [('EbN0_min', '0.0'), ('EbN0_max', '14.0'),
      ('EbN0_step', '1.0'), ('samp_rate', '256000.0'), ('bit_rate', '64000.0'), ('bits_por_punto',
      '100000'), ('bits_guardia', '1000'), ('signal_power', '0.0'), ('seed', '2026')],
      [('0', 'complex', 1)], [('0', 'complex', 1), ('1', 'float', 1)], '', ['EbN0_max',
      'EbN0_min', 'EbN0_step', 'bit_rate', 'bits_guardia', 'bits_por_punto', 'samp_rate'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [672, 588.0]
    rotation: 0
    state: enabled
- name: e_Metricas_Sistema_CSV
  id: epy_block
  parameters:
    _source_code: "\"\"\"\r\ne_Metricas_Sistema_CSV\r\nVersi\xF3n sincronizada con\
      \ e_EbN0_Sweep.\r\n\r\nEntradas:\r\n  0: I/Q limpia de referencia (complex)\r\
      \n  1: I/Q con ruido / perturbaci\xF3n (complex)\r\n  2: bits Tx de referencia\
      \ (byte 0/1)\r\n  3: bits Rx recuperados (byte 0/1)\r\n  4: s\xEDmbolos Tx (byte:\
      \ 0...M-1)\r\n  5: s\xEDmbolos Rx decididos (byte: 0...M-1)\r\n  6: Eb/N0 actual\
      \ entregado por la salida 1 de e_EbN0_Sweep (float)\r\n\r\nCada fila del CSV\
      \ queda asociada a UN SOLO valor de Eb/N0.\r\nLos primeros bitsGuardia de cada\
      \ tramo se excluyen de la medici\xF3n.\r\n\r\nIMPORTANTE:\r\n- bitsPerRecord\
      \ debe ser igual a bits_por_punto de e_EbN0_Sweep.\r\n- bitsGuardia debe ser\
      \ igual a bits_guardia de e_EbN0_Sweep.\r\n- Las entradas I/Q 0, 1 y 6 deben\
      \ pertenecer al mismo flujo y estar alineadas.\r\n- delayBits y delaySymbols\
      \ compensan el retardo del receptor.\r\n\"\"\"\r\n\r\nimport numpy as np\r\n\
      from collections import deque\r\nfrom pathlib import Path\r\nimport csv\r\n\
      from gnuradio import gr\r\n\r\n\r\nclass blk(gr.basic_block):\r\n    def __init__(self,\r\
      \n                 modulationType=\"BPSK\",\r\n                 bitsPerSymbolM=1,\r\
      \n                 sampRateHz=320000.0,\r\n                 symbolRateRsBaud=32000.0,\r\
      \n                 bandwidthBwHz=43200.0,\r\n                 amplitudeAV=1.0,\r\
      \n                 bitsPerRecord=100000,\r\n                 bitsGuardia=1000,\r\
      \n                 delayBits=0,\r\n                 delaySymbols=0,\r\n    \
      \             csvFilename=\"metricas_sistema.csv\",\r\n                 overwriteOnStart=True):\r\
      \n\r\n        gr.basic_block.__init__(\r\n            self,\r\n            name=\"\
      e_Metricas_Sistema_CSV\",\r\n            in_sig=[\r\n                np.complex64,\
      \  # 0 I/Q limpia\r\n                np.complex64,  # 1 I/Q con ruido\r\n  \
      \              np.uint8,      # 2 bits Tx\r\n                np.uint8,     \
      \ # 3 bits Rx\r\n                np.uint8,      # 4 s\xEDmbolos Tx\r\n     \
      \           np.uint8,      # 5 s\xEDmbolos Rx\r\n                np.float32\
      \     # 6 Eb/N0 actual\r\n            ],\r\n            out_sig=[]\r\n     \
      \   )\r\n\r\n        # Se conservan los nombres internos originales.\r\n   \
      \     self.modulation_type = str(modulationType)\r\n        self.bits_per_symbol_m\
      \ = max(1, int(bitsPerSymbolM))\r\n        self.samp_rate_hz = float(sampRateHz)\r\
      \n        self.symbol_rate_rs_baud = float(symbolRateRsBaud)\r\n        self.bandwidth_bw_hz\
      \ = float(bandwidthBwHz)\r\n        self.amplitude_a_v = float(amplitudeAV)\r\
      \n        self.bits_per_record = max(1, int(bitsPerRecord))\r\n        self.bits_guardia\
      \ = max(0, int(bitsGuardia))\r\n        self.delay_bits = max(0, int(delayBits))\r\
      \n        self.delay_symbols = max(0, int(delaySymbols))\r\n        self.csv_filename\
      \ = str(csvFilename)\r\n        self.overwrite_on_start = bool(overwriteOnStart)\r\
      \n\r\n        if self.samp_rate_hz <= 0:\r\n            raise ValueError(\"\
      sampRateHz debe ser > 0\")\r\n        if self.symbol_rate_rs_baud <= 0:\r\n\
      \            raise ValueError(\"symbolRateRsBaud debe ser > 0\")\r\n       \
      \ if self.bandwidth_bw_hz < 0:\r\n            raise ValueError(\"bandwidthBwHz\
      \ debe ser >= 0\")\r\n\r\n        self.bit_rate = (\r\n            self.symbol_rate_rs_baud\r\
      \n            * self.bits_per_symbol_m\r\n        )\r\n\r\n        # Deben coincidir\
      \ con e_EbN0_Sweep.\r\n        self.segment_bits = (\r\n            self.bits_guardia\r\
      \n            + self.bits_per_record\r\n        )\r\n\r\n        # Conversi\xF3\
      n de la guarda de bits a muestras I/Q.\r\n        self.guard_iq_samples = max(\r\
      \n            0,\r\n            int(round(\r\n                self.bits_guardia\r\
      \n                * self.samp_rate_hz\r\n                / self.bit_rate\r\n\
      \            ))\r\n        )\r\n\r\n        self.csv_path = Path.cwd() / self.csv_filename\r\
      \n\r\n        self.header = [\r\n            \"modulation_type\",\r\n      \
      \      \"bits_per_symbol_m\",\r\n            \"samp_rate_hz\",\r\n         \
      \   \"symbol_rate_rs_baud\",\r\n            \"bandwidth_bw_hz\",\r\n       \
      \     \"amplitude_a_v\",\r\n            \"ebn0_db\",\r\n            \"noise_variance_sigma2\"\
      ,\r\n            \"measured_snr_db\",\r\n            \"measured_ber\",\r\n \
      \           \"measured_ser\",\r\n            \"iq_dispersion_rms\"\r\n     \
      \   ]\r\n\r\n        # Alineaci\xF3n Tx/Rx.\r\n        self.bit_fifo = deque()\r\
      \n        self.symbol_fifo = deque()\r\n        self.raw_bit_items = 0\r\n \
      \       self.raw_symbol_items = 0\r\n\r\n        # \xCDndices v\xE1lidos despu\xE9\
      s de la compensaci\xF3n de retardo.\r\n        self.valid_bit_index = 0\r\n\
      \        self.valid_symbol_index = 0\r\n\r\n        # Estado I/Q controlado\
      \ por la entrada Eb/N0.\r\n        self.current_ebn0 = None\r\n        self.iq_segment_seq\
      \ = -1\r\n        self.iq_segment_sample_pos = 0\r\n        self.iq_clean_energy\
      \ = 0.0\r\n        self.iq_noise_energy = 0.0\r\n        self.iq_count = 0\r\
      \n\r\n        # Estado BER.\r\n        self.bit_segment_seq = 0\r\n        self.bit_count\
      \ = 0\r\n        self.bit_errors = 0\r\n\r\n        # Estado SER.\r\n      \
      \  self.symbol_segment_seq = 0\r\n        self.symbol_count = 0\r\n        self.symbol_errors\
      \ = 0\r\n\r\n        # Resultados parciales por n\xFAmero de tramo.\r\n    \
      \    self.iq_results = {}\r\n        self.bit_results = {}\r\n        self.symbol_results\
      \ = {}\r\n        self.written_segments = set()\r\n\r\n        self._prepare_csv()\r\
      \n\r\n        print(\"CSV de m\xE9tricas se guardar\xE1 en:\")\r\n        print(self.csv_path)\r\
      \n\r\n    def _prepare_csv(self):\r\n        mode = \"w\" if self.overwrite_on_start\
      \ else \"a\"\r\n\r\n        need_header = (\r\n            self.overwrite_on_start\r\
      \n            or not self.csv_path.exists()\r\n            or self.csv_path.stat().st_size\
      \ == 0\r\n        )\r\n\r\n        if need_header:\r\n            with open(\r\
      \n                self.csv_path,\r\n                mode,\r\n              \
      \  newline=\"\",\r\n                encoding=\"utf-8\"\r\n            ) as f:\r\
      \n                csv.writer(f).writerow(self.header)\r\n\r\n    # ------------------------------------------------------------\r\
      \n    # I/Q + Eb/N0\r\n    # ------------------------------------------------------------\r\
      \n\r\n    def _start_iq_segment(self, ebn0):\r\n        self.iq_segment_seq\
      \ += 1\r\n        self.current_ebn0 = float(ebn0)\r\n        self.iq_segment_sample_pos\
      \ = 0\r\n        self.iq_clean_energy = 0.0\r\n        self.iq_noise_energy\
      \ = 0.0\r\n        self.iq_count = 0\r\n\r\n    def _finish_iq_segment(self):\r\
      \n        if self.iq_segment_seq < 0:\r\n            return\r\n\r\n        self.iq_results[self.iq_segment_seq]\
      \ = {\r\n            \"ebn0_db\": self.current_ebn0,\r\n            \"clean_energy\"\
      : self.iq_clean_energy,\r\n            \"noise_energy\": self.iq_noise_energy,\r\
      \n            \"count\": self.iq_count\r\n        }\r\n\r\n        self._try_write(self.iq_segment_seq)\r\
      \n\r\n    def _process_iq_control(self, clean, noisy, ebn0):\r\n        n =\
      \ min(len(clean), len(noisy), len(ebn0))\r\n\r\n        if n <= 0:\r\n     \
      \       return 0\r\n\r\n        clean = clean[:n]\r\n        noisy = noisy[:n]\r\
      \n        control = ebn0[:n]\r\n\r\n        # Detecta cambios de Eb/N0 sin recorrer\
      \ muestra por muestra.\r\n        changes = np.flatnonzero(\r\n            np.abs(np.diff(control.astype(np.float64)))\
      \ > 1e-6\r\n        ) + 1\r\n\r\n        boundaries = np.concatenate((\r\n \
      \           np.array([0], dtype=np.int64),\r\n            changes.astype(np.int64),\r\
      \n            np.array([n], dtype=np.int64)\r\n        ))\r\n\r\n        for\
      \ k in range(len(boundaries) - 1):\r\n            a = int(boundaries[k])\r\n\
      \            b = int(boundaries[k + 1])\r\n\r\n            if b <= a:\r\n  \
      \              continue\r\n\r\n            eb_value = float(control[a])\r\n\r\
      \n            if self.current_ebn0 is None:\r\n                self._start_iq_segment(eb_value)\r\
      \n\r\n            elif abs(\r\n                eb_value - self.current_ebn0\r\
      \n            ) > 1e-6:\r\n                self._finish_iq_segment()\r\n   \
      \             self._start_iq_segment(eb_value)\r\n\r\n            x = clean[a:b].astype(np.complex128)\r\
      \n            y = noisy[a:b].astype(np.complex128)\r\n\r\n            # Excluir\
      \ la zona de guarda de este tramo.\r\n            run_start = self.iq_segment_sample_pos\r\
      \n            run_end = run_start + len(x)\r\n\r\n            useful_start =\
      \ max(\r\n                self.guard_iq_samples,\r\n                run_start\r\
      \n            )\r\n\r\n            useful_end = run_end\r\n\r\n            if\
      \ useful_end > useful_start:\r\n                ia = useful_start - run_start\r\
      \n                ib = useful_end - run_start\r\n\r\n                xu = x[ia:ib]\r\
      \n                yu = y[ia:ib]\r\n                error = yu - xu\r\n\r\n \
      \               self.iq_clean_energy += float(\r\n                    np.sum(np.abs(xu)\
      \ ** 2)\r\n                )\r\n\r\n                self.iq_noise_energy +=\
      \ float(\r\n                    np.sum(np.abs(error) ** 2)\r\n             \
      \   )\r\n\r\n                self.iq_count += len(xu)\r\n\r\n            self.iq_segment_sample_pos\
      \ += len(x)\r\n\r\n        return n\r\n\r\n    # ------------------------------------------------------------\r\
      \n    # BER\r\n    # ------------------------------------------------------------\r\
      \n\r\n    def _finish_bit_segment(self, seq):\r\n        self.bit_results[seq]\
      \ = {\r\n            \"count\": self.bit_count,\r\n            \"errors\": self.bit_errors\r\
      \n        }\r\n\r\n        self._try_write(seq)\r\n\r\n        self.bit_count\
      \ = 0\r\n        self.bit_errors = 0\r\n\r\n    def _process_bits(self, tx,\
      \ rx):\r\n        n = min(len(tx), len(rx))\r\n\r\n        if n <= 0:\r\n  \
      \          return 0\r\n\r\n        used = 0\r\n\r\n        while used < n:\r\
      \n            t = int(tx[used]) & 1\r\n            r = int(rx[used]) & 1\r\n\
      \r\n            self.bit_fifo.append(t)\r\n\r\n            if len(self.bit_fifo)\
      \ > self.delay_bits:\r\n                t_aligned = self.bit_fifo.popleft()\r\
      \n\r\n                bit_index = self.valid_bit_index\r\n                seq\
      \ = bit_index // self.segment_bits\r\n                pos = bit_index % self.segment_bits\r\
      \n\r\n                if seq != self.bit_segment_seq:\r\n                  \
      \  self._finish_bit_segment(\r\n                        self.bit_segment_seq\r\
      \n                    )\r\n                    self.bit_segment_seq = seq\r\n\
      \r\n                if pos >= self.bits_guardia:\r\n                    self.bit_count\
      \ += 1\r\n\r\n                    if t_aligned != r:\r\n                   \
      \     self.bit_errors += 1\r\n\r\n                self.valid_bit_index += 1\r\
      \n\r\n            self.raw_bit_items += 1\r\n            used += 1\r\n\r\n \
      \       return used\r\n\r\n    # ------------------------------------------------------------\r\
      \n    # SER\r\n    # ------------------------------------------------------------\r\
      \n\r\n    def _finish_symbol_segment(self, seq):\r\n        self.symbol_results[seq]\
      \ = {\r\n            \"count\": self.symbol_count,\r\n            \"errors\"\
      : self.symbol_errors\r\n        }\r\n\r\n        self._try_write(seq)\r\n\r\n\
      \        self.symbol_count = 0\r\n        self.symbol_errors = 0\r\n\r\n   \
      \ def _process_symbols(self, tx, rx):\r\n        n = min(len(tx), len(rx))\r\
      \n\r\n        if n <= 0:\r\n            return 0\r\n\r\n        used = 0\r\n\
      \r\n        while used < n:\r\n            t = int(tx[used])\r\n           \
      \ r = int(rx[used])\r\n\r\n            self.symbol_fifo.append(t)\r\n\r\n  \
      \          if len(self.symbol_fifo) > self.delay_symbols:\r\n              \
      \  t_aligned = self.symbol_fifo.popleft()\r\n\r\n                # Posici\xF3\
      n equivalente en bits.\r\n                bit_index = (\r\n                \
      \    self.valid_symbol_index\r\n                    * self.bits_per_symbol_m\r\
      \n                )\r\n\r\n                seq = bit_index // self.segment_bits\r\
      \n                pos = bit_index % self.segment_bits\r\n\r\n              \
      \  if seq != self.symbol_segment_seq:\r\n                    self._finish_symbol_segment(\r\
      \n                        self.symbol_segment_seq\r\n                    )\r\
      \n                    self.symbol_segment_seq = seq\r\n\r\n                #\
      \ Se cuenta el s\xEDmbolo si su primer bit est\xE1\r\n                # despu\xE9\
      s de la guarda y dentro de la zona \xFAtil.\r\n                if (\r\n    \
      \                pos >= self.bits_guardia\r\n                    and pos < self.segment_bits\r\
      \n                ):\r\n                    self.symbol_count += 1\r\n\r\n \
      \                   if t_aligned != r:\r\n                        self.symbol_errors\
      \ += 1\r\n\r\n                self.valid_symbol_index += 1\r\n\r\n         \
      \   self.raw_symbol_items += 1\r\n            used += 1\r\n\r\n        return\
      \ used\r\n\r\n    # ------------------------------------------------------------\r\
      \n    # Escritura CSV\r\n    # ------------------------------------------------------------\r\
      \n\r\n    def _try_write(self, seq):\r\n        if seq in self.written_segments:\r\
      \n            return\r\n\r\n        if (\r\n            seq not in self.iq_results\r\
      \n            or seq not in self.bit_results\r\n            or seq not in self.symbol_results\r\
      \n        ):\r\n            return\r\n\r\n        iq = self.iq_results[seq]\r\
      \n        bit = self.bit_results[seq]\r\n        sym = self.symbol_results[seq]\r\
      \n\r\n        iq_count = int(iq[\"count\"])\r\n\r\n        if iq_count <= 0:\r\
      \n            return\r\n\r\n        signal_power = (\r\n            iq[\"clean_energy\"\
      ]\r\n            / float(iq_count)\r\n        )\r\n\r\n        noise_power =\
      \ (\r\n            iq[\"noise_energy\"]\r\n            / float(iq_count)\r\n\
      \        )\r\n\r\n        # sigma^2 por componente I o Q.\r\n        noise_variance_sigma2\
      \ = (\r\n            0.5 * noise_power\r\n        )\r\n\r\n        if noise_power\
      \ > 1e-30:\r\n            measured_snr_db = (\r\n                10.0\r\n  \
      \              * np.log10(\r\n                    signal_power / noise_power\r\
      \n                )\r\n            )\r\n        else:\r\n            measured_snr_db\
      \ = float(\"inf\")\r\n\r\n        measured_ber = (\r\n            bit[\"errors\"\
      ] / float(bit[\"count\"])\r\n            if bit[\"count\"] > 0\r\n         \
      \   else float(\"nan\")\r\n        )\r\n\r\n        measured_ser = (\r\n   \
      \         sym[\"errors\"] / float(sym[\"count\"])\r\n            if sym[\"count\"\
      ] > 0\r\n            else float(\"nan\")\r\n        )\r\n\r\n        iq_dispersion_rms\
      \ = np.sqrt(\r\n            max(noise_power, 0.0)\r\n        )\r\n\r\n     \
      \   row = [\r\n            self.modulation_type,\r\n            self.bits_per_symbol_m,\r\
      \n            f\"{self.samp_rate_hz:.6f}\",\r\n            f\"{self.symbol_rate_rs_baud:.6f}\"\
      ,\r\n            f\"{self.bandwidth_bw_hz:.6f}\",\r\n            f\"{self.amplitude_a_v:.6f}\"\
      ,\r\n            f\"{float(iq['ebn0_db']):.6f}\",\r\n            f\"{noise_variance_sigma2:.9f}\"\
      ,\r\n            f\"{measured_snr_db:.6f}\",\r\n            f\"{measured_ber:.9f}\"\
      ,\r\n            f\"{measured_ser:.9f}\",\r\n            f\"{iq_dispersion_rms:.9f}\"\
      \r\n        ]\r\n\r\n        with open(\r\n            self.csv_path,\r\n  \
      \          \"a\",\r\n            newline=\"\",\r\n            encoding=\"utf-8\"\
      \r\n        ) as f:\r\n            csv.writer(f).writerow(row)\r\n\r\n     \
      \   print(\r\n            \"Registro CSV:\",\r\n            self.modulation_type,\r\
      \n            \"Eb/N0=\",\r\n            f\"{float(iq['ebn0_db']):.3f}\",\r\n\
      \            \"SNR=\",\r\n            f\"{measured_snr_db:.3f}\",\r\n      \
      \      \"BER=\",\r\n            f\"{measured_ber:.6g}\",\r\n            \"SER=\"\
      ,\r\n            f\"{measured_ser:.6g}\"\r\n        )\r\n\r\n        self.written_segments.add(seq)\r\
      \n\r\n        # Liberar memoria de tramos ya escritos.\r\n        del self.iq_results[seq]\r\
      \n        del self.bit_results[seq]\r\n        del self.symbol_results[seq]\r\
      \n\r\n    # ------------------------------------------------------------\r\n\
      \    # Scheduler\r\n    # ------------------------------------------------------------\r\
      \n\r\n    def general_work(self, input_items, output_items):\r\n\r\n       \
      \ # I/Q + control Eb/N0\r\n        used_iq = self._process_iq_control(\r\n \
      \           input_items[0],\r\n            input_items[1],\r\n            input_items[6]\r\
      \n        )\r\n\r\n        if used_iq > 0:\r\n            self.consume(0, used_iq)\r\
      \n            self.consume(1, used_iq)\r\n            self.consume(6, used_iq)\r\
      \n\r\n        # Bits\r\n        used_bits = self._process_bits(\r\n        \
      \    input_items[2],\r\n            input_items[3]\r\n        )\r\n\r\n    \
      \    if used_bits > 0:\r\n            self.consume(2, used_bits)\r\n       \
      \     self.consume(3, used_bits)\r\n\r\n        # S\xEDmbolos\r\n        used_symbols\
      \ = self._process_symbols(\r\n            input_items[4],\r\n            input_items[5]\r\
      \n        )\r\n\r\n        if used_symbols > 0:\r\n            self.consume(4,\
      \ used_symbols)\r\n            self.consume(5, used_symbols)\r\n\r\n       \
      \ # Es un bloque sumidero.\r\n        return 0\r\n"
    affinity: ''
    alias: ''
    amplitudeAV: amplitude_a_v
    bandwidthBwHz: bandwidth_bw_hz
    bitsGuardia: bits_guardia
    bitsPerRecord: bits_per_record
    bitsPerSymbolM: bps
    comment: "COPIAR ESTE BLOQUE AL SISTEMA DEL GRUPO.\nEntradas: 0=IQ limpia, 1=IQ\
      \ con ruido, 2=bits Tx, 3=bits Rx, 4=s\xEDmbolos Tx, 5=s\xEDmbolos Rx.\nGenera\
      \ metricas_sistema.csv autom\xE1ticamente."
    csvFilename: csv_filename
    delayBits: delay_bits
    delaySymbols: delay_symbols
    maxoutbuf: '0'
    minoutbuf: '0'
    modulationType: modulation_type
    overwriteOnStart: overwrite_on_start
    sampRateHz: bb_rate
    symbolRateRsBaud: Rs
  states:
    _io_cache: ('e_Metricas_Sistema_CSV', 'blk', [('modulationType', "'BPSK'"), ('bitsPerSymbolM',
      '1'), ('sampRateHz', '320000.0'), ('symbolRateRsBaud', '32000.0'), ('bandwidthBwHz',
      '43200.0'), ('amplitudeAV', '1.0'), ('bitsPerRecord', '100000'), ('bitsGuardia',
      '1000'), ('delayBits', '0'), ('delaySymbols', '0'), ('csvFilename', "'metricas_sistema.csv'"),
      ('overwriteOnStart', 'True')], [('0', 'complex', 1), ('1', 'complex', 1), ('2',
      'byte', 1), ('3', 'byte', 1), ('4', 'byte', 1), ('5', 'byte', 1), ('6', 'float',
      1)], [], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [712.0, 960]
    rotation: 270
    state: enabled
- name: e_Rx_Align
  id: epy_block
  parameters:
    _source_code: "\"\"\"\ne_Rx_Align\nDecisi\xF3n PSK + resoluci\xF3n de ambig\xFC\
      edad de fase/retardo con referencia conocida.\n\nEntrada 0 : s\xEDmbolos complejos\
      \ (1 muestra/s\xEDmbolo) a la salida del lazo Costas.\nEntrada 1 : s\xEDmbolos\
      \ Tx de referencia (byte 0...M-1), tomados antes del modulador.\nSalida 0  :\
      \ s\xEDmbolos Rx decididos y corregidos de rotaci\xF3n (byte 0...M-1).\nSalida\
      \ 1  : s\xEDmbolos Tx de referencia ALINEADOS con la salida 0 (byte 0...M-1).\n\
      \nLa fuente de bits Tx es peri\xF3dica (n_bits_patron bits). El bloque captura\
      \ un\nperiodo de la referencia y, cada 'ventana' s\xEDmbolos, busca por correlaci\xF3\
      n la\nrotaci\xF3n r (ambig\xFCedad del Costas: 2, 4 u 8 fases) y el retardo\
      \ L (m\xF3dulo el\nperiodo) con mayor coincidencia. Se aplica la \xFAltima estimaci\xF3\
      n v\xE1lida, por lo\nque no hay latencia a\xF1adida. Mientras no hay enganche\
      \ (primeros ~1000 s\xEDmbolos)\nla referencia se iguala a la decisi\xF3n (no\
      \ se cuentan errores).\n\n'tabla' es la constelaci\xF3n indexada por etiqueta\
      \ (puntos en ra\xEDces M-\xE9simas de 1).\n\"\"\"\n\nimport math\nimport numpy\
      \ as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n    def __init__(self,\n\
      \                 tabla=(1+0j, -1+0j),\n                 n_bits_patron=1000,\n\
      \                 ventana=200,\n                 zscore=6.0):\n        gr.sync_block.__init__(\n\
      \            self,\n            name='e_Rx_Align',\n            in_sig=[np.complex64,\
      \ np.uint8],\n            out_sig=[np.uint8, np.uint8]\n        )\n        t\
      \ = np.array(tabla, dtype=np.complex128)\n        self._M = len(t)\n       \
      \ M = self._M\n        if M < 2:\n            raise ValueError(\"tabla debe\
      \ tener al menos 2 puntos\")\n        bps = int(round(math.log2(M)))\n     \
      \   pos = np.mod(np.rint(np.angle(t)*M/(2*np.pi)).astype(np.int64), M)\n   \
      \     if len(set(pos.tolist())) != M:\n            raise ValueError(\"tabla\
      \ debe ser PSK con puntos en 2*pi*k/M\")\n        self._lab_of_pos = np.zeros(M,\
      \ dtype=np.uint8)\n        for lab, p in enumerate(pos):\n            self._lab_of_pos[p]\
      \ = lab\n\n        nb = max(1, int(n_bits_patron))\n        self._P = nb*bps//math.gcd(nb,\
      \ bps)//bps   # periodo en s\xEDmbolos\n        self._W = max(50, int(ventana))\n\
      \        c = 1.0/M\n        self._thr = self._W*c + float(zscore)*math.sqrt(self._W*c*(1-c))\n\
      \n        self._pat = np.zeros(self._P, dtype=np.uint8)\n        self._cap =\
      \ 0\n        self._wbuf = np.zeros(self._W, dtype=np.int64)\n        self._wfill\
      \ = 0\n        self._k = 0\n        self._locked = False\n        self._r =\
      \ 0\n        self._L = 0\n        self._miss = 0\n\n    def _update(self):\n\
      \        if self._cap < self._P:\n            return\n        M, W, P = self._M,\
      \ self._W, self._P\n        k0 = self._k - W\n        if self._locked and self._miss\
      \ < 5:\n            Ls = np.mod(self._L + np.arange(-2, 3), P)\n        else:\n\
      \            Ls = np.arange(P)\n        idx = np.mod(k0 + np.arange(W)[None,\
      \ :] + Ls[:, None], P)\n        ref = self._pat[idx]\n        best = (-1, 0,\
      \ 0)\n        for r in range(M):\n            a = self._lab_of_pos[np.mod(self._wbuf\
      \ - r, M)]\n            sc = (ref == a[None, :]).sum(axis=1)\n            j\
      \ = int(sc.argmax())\n            if sc[j] > best[0]:\n                best\
      \ = (int(sc[j]), r, int(Ls[j]))\n        if best[0] >= self._thr:\n        \
      \    if (not self._locked) or best[1] != self._r or best[2] != self._L:\n  \
      \              print(\"[e_Rx_Align] r=%d L=%d coincidencia=%.2f (simbolo %d)\"\
      \n                      % (best[1], best[2], best[0]/W, self._k))\n        \
      \    self._r, self._L = best[1], best[2]\n            self._locked = True\n\
      \            self._miss = 0\n        elif self._locked:\n            self._miss\
      \ += 1\n\n    def work(self, input_items, output_items):\n        x = input_items[0]\n\
      \        t = input_items[1]\n        o_rx = output_items[0]\n        o_ref =\
      \ output_items[1]\n        n = min(len(x), len(t), len(o_rx))\n        if n\
      \ == 0:\n            return 0\n        M, W, P = self._M, self._W, self._P\n\
      \n        if self._cap < P:\n            m = min(P - self._cap, n)\n       \
      \     self._pat[self._cap:self._cap+m] = t[:m]\n            self._cap += m\n\
      \n        p = np.mod(np.rint(np.angle(x[:n])*M/(2*np.pi)).astype(np.int64),\
      \ M)\n        i = 0\n        while i < n:\n            take = min(n - i, W -\
      \ self._wfill)\n            seg = p[i:i+take]\n            self._wbuf[self._wfill:self._wfill+take]\
      \ = seg\n            if self._locked:\n                o_rx[i:i+take] = self._lab_of_pos[np.mod(seg\
      \ - self._r, M)]\n                kk = self._k + np.arange(take)\n         \
      \       o_ref[i:i+take] = self._pat[np.mod(kk + self._L, P)]\n            else:\n\
      \                lab = self._lab_of_pos[seg]\n                o_rx[i:i+take]\
      \ = lab\n                o_ref[i:i+take] = lab\n            self._wfill += take\n\
      \            self._k += take\n            i += take\n            if self._wfill\
      \ == W:\n                self._update()\n                self._wfill = 0\n \
      \       return n\n"
    affinity: ''
    alias: ''
    comment: "Decisi\xF3n PSK + alineaci\xF3n Tx/Rx"
    maxoutbuf: '0'
    minoutbuf: '0'
    n_bits_patron: '1000'
    tabla: tabla_de_verdad_constelacion
    ventana: '200'
    zscore: '6.0'
  states:
    _io_cache: ('e_Rx_Align', 'blk', [('tabla', '((1+0j), (-1+0j))'), ('n_bits_patron',
      '1000'), ('ventana', '200'), ('zscore', '6.0')], [('0', 'complex', 1), ('1',
      'byte', 1)], [('0', 'byte', 1), ('1', 'byte', 1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2196.0, 512]
    rotation: 270
    state: enabled
